# Database
DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/agent45

# Comma-separated list of frontend origins allowed to call this API.
# Only relevant when the frontend and backend are deployed separately
# (e.g. Vercel + Render/Railway) — add your deployed frontend URL here.
# Not needed for the combined single-container deployment (see repo root
# Dockerfile), since the frontend and API are same-origin there.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Combined single-container deployment only (repo root Dockerfile sets these
# automatically — leave unset for local dev or a split deployment):
#   API_PREFIX=/api            # every backend route moves under /api/...
#   FRONTEND_PROXY_URL=http://127.0.0.1:3000   # where the built Next.js app listens internally

# AI service
GROQ_API_KEY=your_groq_api_key_here
# Optional: defaults to llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Application and authentication secrets
SECRET_KEY=replace_with_a_long_random_secret
AUTH_SECRET=replace_with_a_different_long_random_secret
# DEV ONLY: lets requests authenticate via an `x-user-id` header with no password.
# Defaults to false in code. Only set true on your local machine; never in a
# deployed or shared environment.
AUTH_ALLOW_DEV_HEADER=true
AUTH_BOOTSTRAP_TOKEN=replace_with_a_one_time_bootstrap_secret

# Automatic mentoring reminders
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_HOURS=24

# Gmail SMTP notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
SMTP_FROM_EMAIL=yourgmail@gmail.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
